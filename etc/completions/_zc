#compdef zc

_zc() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '(-v --version)'{-v,--version}'[Show version]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '1: :_zc_subcommands' \
        '*::args:->args'

    case $state in
        args)
            case $line[1] in
                run)     _zc_run     ;;
                create)  _zc_create  ;;
                init)    _zc_init    ;;
                list)    _zc_list    ;;
                build)   _zc_build   ;;
                install) _zc_install ;;
                remove)  _zc_remove  ;;
                add)     _zc_add     ;;
                publish) _zc_publish ;;
                clean)   _zc_clean   ;;
                update)  _zc_update  ;;
                # login)   _zc_login   ;;
                # logout)  _zc_logout  ;;
            esac
    esac
}

_zc_get_templates() {
    local type="$1"
    local -a templates
    templates=(${(f)"$(zc list -sq $type 2>/dev/null)"})
    _describe 'template' templates
}

_zc_get_packages() {
    local type="$1"
    local -a packages
    packages=(${(f)"$(zc list -sq $type 2>/dev/null)"})
    _describe 'package' packages
}

_zc_subcommands() {
    local subcommands
    subcommands=(
        'run:Compile and execute C/C++ file(s)'
        'create:Create file based on template'
        'init:Initialize empty project'
        'list:List installed libraries'
        'build:Build project'
        'install:Install packages'
        'remove:Remove packages'
        'add:Add dependencies from global registry'
        'publish:Publish package to server'
        'clean:Clean temporary files and directories'
        'update:Update packages'
        'login:Log into an account'
        'logout:Log out'
    )
    _describe 'subcommand' subcommands
}

_zc_run() {
    _arguments \
        '*:source file:_files -g "*.{c,cc,cpp,cxx,C,o,i,s,asm}"' \
        '(-a --args)'{-a,--args}'[Arguments passed to the program]:args' \
        '(-f --force)'{-f,--force}'[Force compiling even if target already exists]' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '(-k --keep)'{-k,--keep}'[Do not delete executable after being executed]' \
        '(-p --plus)'{-p,--plus}'[Force compilation as C++]' \
        '(-s --static)'{-s,--static}'[Compile using static libraries]' \
        '(-E --preprocess)'{-E,--preprocess}'[Preprocess only]' \
        '(-S --assemble)'{-S,--assemble}'[Compile but do not assemble or link]' \
        '(-c --compile)'{-c,--compile}'[Compile and assemble but do not link]'
        '--std[Add C/C++ standard from config file]' \
}

_zc_create() {
    _arguments \
        '*:file to create:_files' \
        '(-i --input)'{-i,--input}'[Files to use as basis]:file:_files -g "*.{c,cc,cpp,cxx,C}"' \
        '(-f --force)'{-f,--force}'[Force writing even if files already exist]' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '(-e --edit)'{-e,--edit}'[Open files in editor once created]'
}

_zc_init() {
    _arguments \
        ':path:_directories' \
        '(-a --author)'{-a,--author}'[Project author]:author' \
        '(-T --template)'{-T,--template}'[Template to use]:template:_zc_get_templates -p' \
        '(-n --name)'{-n,--name}'[Package name]:name' \
        '(-s --src-folder)'{-s,--src-folder}'[Source folder]:folder:_directories' \
        '(-i --include-folder)'{-i,--include-folder}'[Include folder]:folder:_directories' \
        '(-t --type)'{-t,--type}'[Project type]:type:((bin\:"Executable binary" lib\:"C/C++ Library"))' \
        '(-f --force)'{-f,--force}'[Force initialization]' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '(-e --edit)'{-e,--edit}'[Open project in editor once initialized]' \
        '(-g --git)'{-g,--git}'[Create empty git repository]'
}

_zc_list() {
    _arguments \
        ':path:_directories' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '(-g --global)'{-g,--global}'[List global libraries]' \
        '(-t --templates)'{-t,--templates}'[List templates]' \
        '(-p --project-templates)'{-p,--project-templates}'[List project templates]' \
        '(-s --simple)'{-s,--simple}'[Simple display instead of table]' \
        '(-r --remote)'{-r,--remote}'[Display remote available packages]'
}

_zc_build() {
    _arguments \
        ':path:_directories' \
        '(-f --force)'{-f,--force}'[Force regenerating CMakeLists.txt]' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '(-c --clean)'{-c,--clean}'[Clean after building]' \
        '(-r --release)'{-r,--release}'[Build in release mode]'
}

_zc_install() {
    _arguments \
        '*:package:{_zc_get_packages -r}' \
        '(-p --path)'{-p,--path}'[Install from local path]:path:_directories' \
        '(-f --force)'{-f,--force}'[Force installing even if already installed]' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '(-g --global)'{-g,--global}'[Install the package globally]'
}

_zc_remove() {
    _arguments \
        '*:package:' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '(-g --global)'{-g,--global}'[Remove globally installed packages]'
}

_zc_add() {
    _arguments \
        '*:package:{_zc_get_packages -g}' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]'
}

_zc_publish() {
    _arguments \
        ':path:_directories' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]'
}

_zc_clean() {
    _arguments \
        ':path:_directories' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '(-f --force)'{-f,--force}'[Force cleaning build directory]'
}

_zc_update() {
    _arguments \
        '*:package:' \
        '(-p --path)'{-p,--path}'[Update package from local path instead of remote]:path:_directories' \
        '(-g --global)'{-g,--global}'[Update globally installed package]' \
        '(-f --force)'{-f,--force}'[Force updating the package even if already at latest version]' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]'
}

_zc "$@"
