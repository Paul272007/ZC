#compdef zc

_zc() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '(-v --version)'{-v,--version}'[Show version]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '1: :_zc_subcommands' \
        '*::args:->args'

    case $state in
        args)
            case $line[1] in
                run)       _zc_run       ;;
                create)    _zc_create    ;;
                init)      _zc_init      ;;
                list)      _zc_list      ;;
                build)     _zc_build     ;;
                add)       _zc_add       ;;
                remove)    _zc_remove    ;;
                publish)   _zc_publish   ;;
                clean)     _zc_clean     ;;
                install)   _zc_install   ;;
                uninstall) _zc_uninstall ;;
                update)    _zc_update    ;;
                login)     _zc_login     ;;
                logout)    _zc_logout    ;;
            esac
    esac
}

_zc_get_templates() {
    local type="$1"
    local -a templates
    templates=(${(f)"$(zc list -s $type 2>/dev/null)"})
    _describe 'template' templates
}

_zc_get_packages() {
    local type="$1"
    local -a packages
    packages=(${(f)"$(zc list -s $type 2>/dev/null)"})
    _describe 'package' packages
}

_zc_subcommands() {
    local subcommands
    subcommands=(
        'run:Compile and execute C/C++ file(s)'
        'create:Create file based on template'
        'init:Initialize empty project'
        'build:Build project'
        'add:Add dependencies to project'
        'remove:Remove dependencies from project'
        'publish:Publish package to server'
        'clean:Clean all temporary files and directories'
        'list:List installed libraries'
        'install:Install packages'
        'uninstall:Uninstall packages'
        'update:Update packages'
        'login:Log into an account'
        'logout:Log out'
    )
    _describe 'subcommand' subcommands
}

_zc_run() {
    _arguments \
        '*:source file:_files -g "*.{c,cc,cpp,cxx,C,o,i,s,asm}"' \
        '(-a --args)'{-a,--args}'[Arguments passed to the program]:args' \
        '(-f --force)'{-f,--force}'[Force compiling even if target already exists]' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '(-k --keep)'{-k,--keep}'[Do not delete executable after being executed]' \
        '(-p --plus)'{-p,--plus}'[Force compilation as C++]' \
        '(-s --static)'{-s,--static}'[Compile using static libraries]' \
        '(-E --preprocess)'{-E,--preprocess}'[Preprocess only]' \
        '(-S --assemble)'{-S,--assemble}'[Compile but do not assemble or link]' \
        '(-c --compile)'{-c,--compile}'[Compile and assemble but do not link]' \
        '--std[Add C/C++ standard from config file]'
}

_zc_create() {
    _arguments \
        '*:file to create:_files' \
        '(-i --input)'{-i,--input}'[Files to use as basis]:file:_files -g "*.{c,cc,cpp,cxx,C}"' \
        '(-f --force)'{-f,--force}'[Force writing even if files already exist]' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '(-e --edit)'{-e,--edit}'[Open files in editor once created]'
}

_zc_init() {
    _arguments \
        '(-P --project-path)'{-P,--project-path}'[Directory to use as project root]:path:_directories' \
        '(-a --author)'{-a,--author}'[Package author]:author' \
        '(-t --target)'{-t,--target}'[Package target]:target' \
        '(-p --project-template)'{-p,--project-template}'[Project template to use]:template:_zc_get_templates -p' \
        '(-n --name)'{-n,--name}'[Name of the package]:name' \
        '(-g --git)'{-g,--git}'[Initialize empty git repository at project root]' \
        '(-e --edit)'{-e,--edit}'[Open project in editor once initialized]' \
        '(-B --bin)'{-B,--bin}'[Make package of type BIN]' \
        '(-L --lib)'{-L,--lib}'[Make package of type LIB]' \
        '(-H --header)'{-H,--header}'[Make package of type HEADER]' \
        '(-C --is_compose)'{-C,--is_compose}'[Make package of type COMPOSE]'
}

_zc_build() {
    _arguments \
        '(-P --project-path)'{-P,--project-path}'[Directory to use as project root]:path:_directories' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '(-c --clean)'{-c,--clean}'[Clean before building]' \
        '(-r --release)'{-r,--release}'[Build in release mode instead of debug mode]'
}

_zc_add() {
    _arguments \
        '(-P --project-path)'{-P,--project-path}'[Directory to use as project root]:path:_directories' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '*:package:{_zc_get_packages -r}'
}

_zc_remove() {
    _arguments \
        '(-P --project-path)'{-P,--project-path}'[Directory to use as project root]:path:_directories' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '*:package:{_zc_get_packages}'
}

_zc_publish() {
    _arguments \
        '(-P --project-path)'{-P,--project-path}'[Directory to use as project root]:path:_directories' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]'
}

_zc_clean() {
    _arguments \
        '(-P --project-path)'{-P,--project-path}'[Directory to use as project root]:path:_directories' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]'
}

_zc_list() {
    _arguments \
        '(-t --templates)'{-t,--templates}'[Show available templates instead of packages]' \
        '(-p --project-templates)'{-p,--project-templates}'[Show available project templates instead of packages]' \
        '(-r --remote)'{-r,--remote}'[Show remote packages instead of local ones]' \
        '(-s --simple)'{-s,--simple}'[Use a simpler display]'
}

_zc_install() {
    _arguments \
        '(-p --path)'{-p,--path}'[Install from local project instead of remote]:path:_directories' \
        '*:package:{_zc_get_packages -r}'
}

_zc_uninstall() {
    _arguments \
        '*:package:{_zc_get_packages}'
}

_zc_update() {
    _arguments \
        '(-p --path)'{-p,--path}'[Update local package from its root path]:path:_directories' \
        '*:package:{_zc_get_packages}'
}

_zc_login() {
    # No arguments
}

_zc_logout() {
    # No arguments
}

_zc "$@"
