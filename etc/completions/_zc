        '(-t --target)'{-t,--target}'[Package target]:target' \
        '(-p --project-template)'{-p,--project-template}'[Project template to use]:template:_zc_get_templates -p' \
        '(-n --name)'{-n,--name}'[Name of the package]:name' \
        '(-l --languages)'{-l,--languages}'[Languages of the project]:languages' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '(-f --force)'{-f,--force}'[Force initialization even if a project already exists]' \
        '(-g --git)'{-g,--git}'[Initialize empty git repository at project root]' \
        '(-e --edit)'{-e,--edit}'[Open project in editor once initialized]' \
        '(-B --bin)'{-B,--bin}'[Make package of type BIN]' \
        '(-L --lib)'{-L,--lib}'[Make package of type LIB]' \
        '(-H --header)'{-H,--header}'[Make package of type HEADER]' \
        '(-C --compose)'{-C,--compose}'[Make package of type COMPOSE]'
}

