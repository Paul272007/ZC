        '*::args:->args'

    case $state in
        args)
            case $line[1] in
                add)    _zc_languages_add    ;;
                remove) _zc_languages_remove ;;
                edit)   _zc_languages_edit   ;;
                show)   _zc_languages_show   ;;
            esac
    esac
}

