#compdef zc

_zc() {
    local context state state_descr line
    typeset -A opt_args

    _arguments -C \
        '(-v --version)'{-v,--version}'[Show version]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '1: :_zc_subcommands' \
        '*::args:->args'

    case $state in
        args)
            case $line[1] in
                run)       _zc_run       ;;
                create)    _zc_create    ;;
                init)      _zc_init      ;;
                setup)     _zc_setup     ;;
                build)     _zc_build     ;;
                add)       _zc_add       ;;
                remove)    _zc_remove    ;;
                use)       _zc_use       ;;
                publish)   _zc_publish   ;;
                clean)     _zc_clean     ;;
                list)      _zc_list      ;;
                install)   _zc_install   ;;
                uninstall) _zc_uninstall ;;
                update)    _zc_update    ;;
                login)     _zc_login     ;;
                logout)    _zc_logout    ;;
                config)    _zc_config    ;;
                languages) _zc_languages ;;
            esac
    esac
}

_zc_get_templates() {
    local type="$1"
    local -a templates
    templates=(${(f)"$(zc list -s $type 2>/dev/null)"})
    _describe 'template' templates
}

_zc_get_packages() {
    local type="$1"
    local -a packages
    packages=(${(f)"$(zc list -s $type 2>/dev/null)"})
    _describe 'package' packages
}

_zc_subcommands() {
    local subcommands
    subcommands=(
        'run:Compile and execute C/C++ file(s)'
        'create:Create file based on template'
        'init:Initialize empty project'
        'setup:(Re)generate build configuration'
        'build:Build project'
        'add:Add dependencies to project'
        'remove:Remove dependencies from project'
        'use:Choose version of dependency to use'
        'publish:Publish package to server'
        'clean:Clean all temporary files and directories'
        'list:List installed libraries'
        'install:Install packages'
        'uninstall:Uninstall packages'
        'update:Update packages'
        'login:Log into an account'
        'logout:Log out'
        'config:Manage configuration'
        'languages:Manage languages'
    )
    _describe 'subcommand' subcommands
}

_zc_run() {
    _arguments \
        '*:source file:_files -g "*.{c,cc,cpp,cxx,C,o,i,s,asm}"' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '(-a --args)'{-a,--args}'[Arguments passed to the program]:args' \
        '(-f --force)'{-f,--force}'[Force compiling even if target already exists]' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '(-k --keep)'{-k,--keep}'[Do not delete executable after being executed]' \
        '(-p --plus)'{-p,--plus}'[Force compilation as C++]' \
        '(-s --static)'{-s,--static}'[Compile prioritizing the use of static libraries]' \
        '(-E --preprocess)'{-E,--preprocess}'[Preprocess only]' \
        '(-S --assemble)'{-S,--assemble}'[Compile, but do not assemble or link]' \
        '(-c --compile)'{-c,--compile}'[Compile and assemble, but do not link]' \
        '(-n --no-flags)'{-n,--no-flags}'[Do not add flags from configuration file]' \
        '(-r --release)'{-r,--release}'[Compile in release mode]' \
        '--std[Add C/C++ standard from config file]'
}

_zc_create() {
    _arguments \
        '*:file to create:_files' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '(-i --input)'{-i,--input}'[Files to use as basis]:file:_files -g "*.{c,cc,cpp,cxx,C}"' \
        '(-f --force)'{-f,--force}'[Force creating file even if it already exists]' \
        '(-q --quiet)'{-q,--quiet}'[Do not show any messages]' \
        '(-e --edit)'{-e,--edit}'[Open files in editor once created]'
}

