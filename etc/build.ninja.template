ninja_required_version = 1.10

ar = {{ AR }}

{% if HAS_CXX %}
rule compile_cxx
    command = {{ CXX_COMPILER }} -std={{ CXX_STD }} {{ CXX_FLAGS }} $includes $macros -MD -MF $out.d -c $in -o $out -fdiagnostics-color=always
    depfile = $out.d
    deps = gcc
{% endif %}

{% if HAS_C %}
rule compile_c
    command = {{ C_COMPILER }} -std={{ C_STD }} {{ C_FLAGS }} $includes $macros -MD -MF $out.d -c $in -o $out -fdiagnostics-color=always
    depfile = $out.d
    deps = gcc
{% endif %}

rule link
    command = $linker $in $ldflags -o $out

rule archive
    command = $ar rcs $out $in

{% for STMT in BUILD_STATEMENTS %}
{{ STMT }}
{% endfor %}

build all: phony{% for T in ALL_OUTPUTS %} {{ T }}{% endfor %}
default all
